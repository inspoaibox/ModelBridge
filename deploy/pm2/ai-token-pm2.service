[Unit]
Description=PM2 process manager for AI Token Gateway
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=forking
User=root
Group=root
Environment=HOME=/root
Environment=PM2_HOME=/opt/ai-token/.pm2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PIDFile=/opt/ai-token/.pm2/pm2.pid
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
ExecStart=/usr/bin/env pm2 resurrect
ExecReload=/usr/bin/env pm2 reload ai-token --update-env
ExecStop=/usr/bin/env pm2 kill

[Install]
WantedBy=multi-user.target

APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_TIMEOUT=60s
HTTP_WRITE_TIMEOUT=15m
HTTP_IDLE_TIMEOUT=2m
WEB_DIR=web
DATABASE_URL=postgres://app_user:change-me@127.0.0.1:5432/ai_token
MIGRATIONS_DIR=migrations
TOKEN_PEPPER=replace-with-at-least-32-random-characters
SESSION_PEPPER=replace-with-a-different-at-least-32-random-string
MFA_ENCRYPTION_KEY=replace-with-64-hex-characters
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://gateway.example.com
REGISTRATION_ENABLED=false
# Required whenever public registration is enabled in production.
REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
PUBLIC_BASE_URL=https://gateway.example.com
SMTP_ADDR=smtp.example.com:587
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
SESSION_TTL=12h
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCK_DURATION=15m
